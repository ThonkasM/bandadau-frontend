{
  "name": "bandadau-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "i18n:check": "node ./scripts/i18n-check.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@bandada/contracts-ts": "file:../bandadau-shared/packages/contracts-ts",
    "@bandada/i18n": "file:../bandadau-shared/packages/i18n",
    "@bandada/ui-tokens": "file:../bandadau-shared/packages/ui-tokens",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-sync-storage-persister": "^5.104.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "expo": "~57.0.29",
    "expo-application": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.5",
    "i18next-icu": "^2.5.0",
    "intl-messageformat": "^11.0.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@bandada/eslint-config": "file:../bandadau-shared/packages/eslint-config",
    "@bandada/tsconfig": "file:../bandadau-shared/packages/tsconfig",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "msw": "^3.0.3",
    "prettier": "^3.6.0",
    "react-server-dom-webpack": "~19.2.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.ts"],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|nativewind|react-native-css-interop|@bandada/.*))"
    ]
  }
}
